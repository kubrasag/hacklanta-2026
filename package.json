    "start": "npm run build && npm run server",
    "build:art": "python tools/art/build_map.py"
  },
  "devDependencies": {
    "terser": "^5.39.0",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "phaser": "4.0.0"
  }
